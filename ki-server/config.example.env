# Kopiere diese Datei nach config.env und trage deine Daten ein:
#   cp config.example.env config.env && nano config.env

# --- Adobe Stock (Portal -> "Hochladen" -> "FTP/SFTP" -> Zugangsdaten anzeigen) ---
ADOBE_SFTP_USER=
ADOBE_SFTP_PASSWORD=
# Erst auf true stellen, wenn du ein paar Testbilder angesehen hast und sie gut findest.
UPLOAD_ENABLED=false

# --- Wie viele Bilder pro Tag (Qualität vor Masse! Adobe sperrt Massen-Uploads) ---
IMAGES_PER_DAY=15

# --- Optional: Telegram-Benachrichtigung, wenn Bilder zum Einreichen bereitliegen ---
# Bot anlegen bei @BotFather -> Token hier eintragen.
# Chat-ID: dem Bot eine Nachricht schreiben, dann
#   https://api.telegram.org/bot<TOKEN>/getUpdates  öffnen -> "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EVERY=20

# --- KI-Modelle (normalerweise nicht ändern) ---
OLLAMA_MODEL=qwen2.5:3b
SD_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SD_STEPS=25
